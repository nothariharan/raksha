{
  "name": "@raksha/web",
  "version": "0.1.0",
  "type": "module",
  "description": "Raksha Citizen Web App & Developer Action Console",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@raksha/cap-sdk": "workspace:*",
    "@raksha/i18n": "workspace:*",
    "@raksha/schemas": "workspace:*",
    "@raksha/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "thesvg": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
