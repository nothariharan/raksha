# =================================================================
# Raksha Protocol — Environment Configuration Template (.env.example)
# Copy to `.env.local` for local development. Never commit real secrets.
# =================================================================

# 1. Database & Persistence (Postgres / Supabase / Local JSON DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raksha
SUPABASE_URL=https://synthetic-raksha.supabase.co
SUPABASE_SERVICE_ROLE_KEY=synthetic_supabase_service_role_key

# 2. Main LLM & Reasoning
OPENAI_API_KEY=synthetic_openai_api_key
OPENAI_MODEL=luna

# 3. ElevenLabs Conversational Voice AI
ELEVENLABS_API_KEY=synthetic_elevenlabs_api_key
ELEVENLABS_AGENT_PHONE_NUMBER_ID=phnum_synthetic_phone_id
ELEVENLABS_INTAKE_AGENT_ID=agent_synthetic_intake_id
ELEVENLABS_NEGOTIATOR_AGENT_ID=agent_synthetic_negotiator_id
ELEVENLABS_DEMO_NEGOTIATOR_AGENT_ID=agent_synthetic_demo_negotiator_id

# 4. Telephony (Twilio / Exotel / ElevenLabs)
TELEPHONY_PROVIDER=elevenlabs
OUTBOUND_CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=AC_synthetic_twilio_account_sid
TWILIO_AUTH_TOKEN=synthetic_twilio_auth_token
TWILIO_FROM_NUMBER=+16055999677
EXOTEL_ACCOUNT_SID=synthetic_exotel_account_sid
EXOTEL_API_KEY=synthetic_exotel_api_key
EXOTEL_API_TOKEN=synthetic_exotel_api_token
EXOTEL_PHONE_NUMBER=+918000000000

# 5. Scout / Orchestrator Tools
SCOUT_PUBLIC_ORCHESTRATOR_URL=https://synthetic-orchestrator.dev
SCOUT_AGENT_TOOL_SECRET=synthetic_scout_agent_tool_secret
ORCHESTRATOR_URL=http://127.0.0.1:8787
SCOUT_DEMO_DISABLE_AGENT_WEBHOOK_TOOLS=true

# 6. Service Ports
PORT_CORE=3001
PORT_CAP=3002
PORT_PORTAL_A=3003
PORT_PORTAL_B=3004
PORT_WEB=3000
PORT_WHATSAPP=3005
PORT_PHONE=3006

# 7. Internal Service Endpoints
CORE_BASE_URL=http://localhost:3001
CAP_PUBLIC_BASE_URL=http://localhost:3002
PORTAL_A_BASE_URL=http://localhost:3003
PORTAL_B_BASE_URL=http://localhost:3004
CAP_INTERNAL_SECRET=dev_cap_internal_secret_change_in_prod
