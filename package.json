{
  "name": "raksha",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Raksha — Multimodal Emergency Public-Service Protocol for Financial Cyber-Fraud Reporting",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./services/*\" --filter \"./apps/*\" --filter \"./agents/*\" build",
    "typecheck": "pnpm -r run typecheck",
    "test": "tsx test/run-e2e.ts",
    "test:e2e:cap": "tsx test/run-e2e.ts",
    "dev:core": "pnpm --filter @raksha/core dev",
    "dev:cap": "pnpm --filter @raksha/cap dev",
    "dev:portal-a": "pnpm --filter @raksha/portal-a dev",
    "dev:portal-b": "pnpm --filter @raksha/portal-b dev",
    "dev:web": "pnpm --filter @raksha/web dev"
  },
  "devDependencies": {
    "@raksha/cap": "workspace:*",
    "@raksha/cap-sdk": "workspace:*",
    "@raksha/core": "workspace:*",
    "@raksha/i18n": "workspace:*",
    "@raksha/portal-a": "workspace:*",
    "@raksha/portal-b": "workspace:*",
    "@raksha/schemas": "workspace:*",
    "@raksha/shared": "workspace:*",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
