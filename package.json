{
  "name": "raksha",
  "version": "0.7.0",
  "type": "module",
  "private": true,
  "description": "Raksha — Multimodal Emergency Public-Service Protocol for Financial Cyber-Fraud Reporting",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "tsx scripts/prod-server.ts",
    "raksha": "tsx scripts/raksha.ts",
    "preflight": "tsx scripts/preflight.ts",
    "export:web": "tsx scripts/export-web.ts",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter @raksha/core build && pnpm --filter @raksha/cap build && pnpm --filter \"./apps/*\" --filter \"./agents/*\" build",
    "typecheck": "pnpm -r run typecheck",
    "test": "tsx test/run-e2e.ts",
    "test:gateway": "tsx test/test-prod-gateway.ts",
    "test:persistence": "tsx test/persistence-identity.test.ts && tsx test/cold-start-matrix.ts",
    "test:cross-channel": "tsx test/cross-channel.test.ts",
    "test:cap-handoff": "tsx test/cap-event-handoff.test.ts",
    "test:thesis": "tsx test/raksha-thesis.test.ts",
    "test:e2e:cap": "tsx test/run-e2e.ts",
    "verify:prod": "tsx scripts/verify-prod-persistence.ts",
    "demo": "tsx scripts/demo-start.ts",
    "demo:start": "tsx scripts/demo-start.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "healthcheck": "tsx scripts/demo-check.ts",
    "demo:scenario": "tsx scripts/demo-scenario.ts",
    "dev:core": "pnpm --filter @raksha/core dev",
    "dev:cap": "pnpm --filter @raksha/cap dev",
    "dev:portal-a": "pnpm --filter @raksha/portal-a dev",
    "dev:portal-b": "pnpm --filter @raksha/portal-b dev",
    "dev:web": "pnpm --filter @raksha/web dev",
    "dev:whatsapp": "pnpm --filter @raksha/agent-whatsapp dev",
    "dev:phone": "pnpm --filter @raksha/agent-phone dev",
    "dev:mcp": "pnpm --filter @raksha/agent-mcp dev"
  },
  "devDependencies": {
    "@raksha/agent-mcp": "workspace:*",
    "@raksha/agent-phone": "workspace:*",
    "@raksha/agent-whatsapp": "workspace:*",
    "@raksha/cap": "workspace:*",
    "@raksha/cap-sdk": "workspace:*",
    "@raksha/core": "workspace:*",
    "@raksha/i18n": "workspace:*",
    "@raksha/portal-a": "workspace:*",
    "@raksha/portal-b": "workspace:*",
    "@raksha/schemas": "workspace:*",
    "@raksha/shared": "workspace:*",
    "@raksha/web": "workspace:*",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "thesvg": "^3.3.1"
  }
}
